# Copy to .env and fill in — Storybook reads these; the published library does not.
# Only VITE_-prefixed variables reach the browser bundle (see envPrefix in Vite docs).

# The DocSpace portal every story points at.
VITE_DOCSPACE_URL=https://your-portal.onlyoffice.com

# The file the Editor story opens. Any file id from the portal above.
VITE_DOCSPACE_FILE_ID=
